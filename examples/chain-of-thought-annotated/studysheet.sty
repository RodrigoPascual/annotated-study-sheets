%% ---------------------------------------------------------------- fonts
%% Handwriting: Segoe Print where it exists (Windows), otherwise Comic Neue (ships with TeX Live, SIL OFL).
%% Printed labels: Segoe UI, otherwise Fira Sans / Latin Modern Sans. Override with \StudyHandFont{Font Name}.
\newcommand\ss@fallbacklist{}
\IfFontExistsTF{Segoe UI Symbol}{\appto\ss@fallbacklist{"Segoe UI Symbol:mode=harf;",}}{}
\IfFontExistsTF{DejaVu Sans}{\appto\ss@fallbacklist{"DejaVu Sans:mode=harf;",}}{}
\IfFontExistsTF{Cambria}{\appto\ss@fallbacklist{"Cambria:mode=harf;",}}{}
\directlua{luaotfload.add_fallback("ssfb", {\ss@fallbacklist})}
\newcommand\StudyHandFont[1]{%
  \setmainfont{#1}[ItalicFont=*, ItalicFeatures={FakeSlant=0.16}, BoldItalicFont=* Bold,
    BoldItalicFeatures={FakeSlant=0.16}, RawFeature={fallback=ssfb}]}
\IfFontExistsTF{Segoe Print}
  {\setmainfont{Segoe Print}[BoldFont=Segoe Print Bold, ItalicFont=Segoe Print, ItalicFeatures={FakeSlant=0.16},
     BoldItalicFont=Segoe Print Bold, BoldItalicFeatures={FakeSlant=0.16}, RawFeature={fallback=ssfb}]}
  {\setmainfont{ComicNeue}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-RegularItalic,
     BoldItalicFont=*-BoldItalic, RawFeature={fallback=ssfb}]\def\ss@comic{}}
\IfFontExistsTF{Segoe UI}
  {\newfontfamily\printed{Segoe UI}[RawFeature={fallback=ssfb}]}
  {\IfFontExistsTF{Fira Sans}{\newfontfamily\printed{Fira Sans}[RawFeature={fallback=ssfb}]}
                            {\newfontfamily\printed{Latin Modern Sans}}}
\setmathfont{STIX Two Math}

