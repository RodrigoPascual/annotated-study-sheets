%% ---------------------------------------------------------------- geometry (mm) — set by main.tex
\newcommand\ss@W{215.9}\newcommand\ss@H{279.4}\newcommand\ss@xmark{184}
\newcommand\StudyPageSize[2]{\renewcommand\ss@W{#1}\renewcommand\ss@H{#2}}
\newcommand\StudyBracketX[1]{\renewcommand\ss@xmark{#1}}   % x of the numbered brackets (right margin of the original)
\newcommand\ss@pdf{}\newcommand\StudyPDF[1]{\renewcommand\ss@pdf{#1}}
\newcommand\ss@total{?}\newcommand\StudyTotal[1]{\renewcommand\ss@total{#1}}
\newcommand\ss@foot{}\newcommand\StudyFooter[1]{\renewcommand\ss@foot{#1}}
\newcommand\ss@fs{8.2}\newcommand\ss@bs{11.4}
\ifdefined\ss@comic\renewcommand\ss@fs{8.9}\renewcommand\ss@bs{12.0}\fi   % Comic Neue runs smaller than Segoe Print
\newcommand\StudyFontSize[2]{\renewcommand\ss@fs{#1}\renewcommand\ss@bs{#2}}
%% sections shown as pills in the header: \StudySections{abs/Abstract,intro/1 Intro,...}
\newcommand\ss@sections{}\newcommand\ss@nsections{1}
\newcommand\StudySections[1]{\renewcommand\ss@sections{#1}%
  \def\ss@n{0}\foreach \k/\t in {#1} {\pgfmathtruncatemacro\ss@m{\ss@n+1}\global\let\ss@n\ss@m}%
  \edef\ss@nsections{\ss@n}}
%% derived positions (computed per spread)
\newcommand\ss@derive{%
  \pgfmathsetmacro\ss@xn{\ss@W+13}%            left edge of the notes text
  \pgfmathsetmacro\ss@wn{\ss@W-26}%            width of the notes text
  \pgfmathsetmacro\ss@ytop{31}%                top of the first block
  \pgfmathsetmacro\ss@ybot{\ss@H-9}}%          no block may end below this
\newcommand\NotesWidth{\ss@wn}

%% ---------------------------------------------------------------- body of the notes
\newcommand\ss@body{\fontsize{\ss@fs}{\ss@bs}\selectfont\color{ink}\parindent=0pt\parskip=1.6pt plus .5pt}
\setlist{nosep, leftmargin=4.2mm, labelsep=1.4mm, topsep=.8mm, itemsep=.6mm}
\newlist{points}{itemize}{2}
\setlist[points,1]{label={\textcolor{accent}{\small\textbullet}}}
\setlist[points,2]{label={\textcolor{greyink}{--}}}
\newlist{arrows}{itemize}{1}
\setlist[arrows]{label={\textcolor{pen}{$\rightarrow$}}, leftmargin=5mm}
\newlist{steps}{enumerate}{1}
\setlist[steps]{label={\textcolor{accent}{\bfseries\arabic*.}}, leftmargin=5mm}

%% coloured words and terms
\newcommand\red[1]{\textcolor{pen}{#1}}
\newcommand\green[1]{\textcolor{ok}{#1}}
\newcommand\blue[1]{\textcolor{blueink}{#1}}
\newcommand\amber[1]{\textcolor{amber}{#1}}
\newcommand\teal[1]{\textcolor{teal}{#1}}
\newcommand\orange[1]{\textcolor{orangeink}{#1}}
\newcommand\purple[1]{\textcolor{maths}{#1}}
\newcommand\grey[1]{\textcolor{greyink}{#1}}
\newcommand\hl[2][hlyellow]{\highLight[#1]{#2}}               % highlighter inside the notes
\newcommand\orig[1]{\textcolor{greyink}{\printed\itshape #1}}  % a term exactly as printed in the original

%% headings inside blocks: hand-underlined
\newlength\ss@tmp
\newcommand\heading[2][accent]{\par\addvspace{.6mm}%
  \settowidth\ss@tmp{\fontsize{10.4}{12.4}\selectfont\bfseries #2}%
  {\fontsize{10.4}{12.4}\selectfont\bfseries\color{#1}#2}\par\nointerlineskip\vspace{.2mm}%
  \tikz\draw[color=#1, line width=1.1pt, line cap=round, decorate,
    decoration={random steps, segment length=3mm, amplitude=.22mm}] (0,0) -- (\ss@tmp,0);\par\addvspace{.6mm}}
\newcommand\sub[2][accent]{\par\addvspace{.5mm}{\bfseries\color{#1}#2}\par\addvspace{.2mm}}

%% numbered badge in the notes: the same number as the mark on the original page
\newcommand\num[2][pen]{\tikz[baseline=(n.base)]\node[circle, fill=#1, text=white, inner sep=0pt, minimum size=4.3mm,
  font=\printed\bfseries\fontsize{7.5}{8}\selectfont] (n) {#2};}

%% boxes
\tcbset{ss/.style={enhanced, breakable=false, boxrule=0pt, arc=1.2mm, left=2mm, right=2mm, top=1mm, bottom=1mm,
  fontupper=\ss@body, before skip=1.2mm, after skip=1.2mm, frame hidden}}
\newtcolorbox{keyidea}[1][\ss@tKey]{ss, colback=hlyellow!35, borderline west={2.2pt}{0pt}{amber!80},
  title={\faLightbulb[regular]\ #1}, attach title to upper={\ }, coltitle=amber, fonttitle=\bfseries}
\newtcolorbox{warning}[1][\ss@tWarn]{ss, colback=pen!7, borderline west={2.2pt}{0pt}{pen},
  title={\faExclamationTriangle\ #1}, attach title to upper={\ }, coltitle=pen, fonttitle=\bfseries}
\newtcolorbox{example}[1][\ss@tEx]{ss, colback=ok!7, borderline west={2.2pt}{0pt}{ok},
  title={\faSeedling\ #1}, attach title to upper={\ }, coltitle=ok, fonttitle=\bfseries}
\newtcolorbox{formula}[1][\ss@tFormula]{ss, colback=maths!6, borderline west={2.2pt}{0pt}{maths},
  title={\faCalculator\ #1}, attach title to upper={\ }, coltitle=maths, fonttitle=\bfseries}
\newtcolorbox{summary}[1][\ss@tSummary]{ss, colback=accent!7, borderline west={2.2pt}{0pt}{accent},
  title={\faFlag\ #1}, attach title to upper={\ }, coltitle=accent, fonttitle=\bfseries}
%% selftest: a self-test question the reader should be able to answer after this page (active recall), then \answer{...}
\newtcolorbox{selftest}[1][\ss@tAsk]{ss, colback=teal!7, borderline west={2.2pt}{0pt}{teal},
  title={\faBrain\ #1}, attach title to upper={\ }, coltitle=teal, fonttitle=\bfseries}
\newcommand\answer[1]{\par\addvspace{.4mm}{\color{teal}\faArrowRight}\ {\color{greyink}\textit{\ss@tAnswer:} #1}}
\newenvironment{question}{\begin{selftest}}{\end{selftest}}   % old name, kept for compatibility

%% small tables: \begin{smalltable}{l r r} a & b & c \\ \midrule ... \end{smalltable}
\newenvironment{smalltable}[1]{\par\smallskip\begingroup\fontsize{7.8}{10.2}\selectfont\arrayrulecolor{greyink}%
  \setlength\tabcolsep{1.6mm}\renewcommand\arraystretch{1.12}\begin{tabular}{#1}}{\end{tabular}\endgroup\par\smallskip}

%% TikZ styles for drawings inside blocks
\tikzset{
  pencil/.style={line width=.9pt, line cap=round, line join=round, decorate,
    decoration={random steps, segment length=2.4mm, amplitude=.3mm}, rounded corners=1.1mm},
  penarrow/.style={line width=.85pt, line cap=round, -{Stealth[length=2.6mm, width=2mm]}},
  boxblue/.style={draw=blueink, fill=blueink!10, rounded corners=1.2mm, line width=.8pt, align=center, inner sep=1.3mm},
  boxamber/.style={draw=amber, fill=amber!14, rounded corners=1.2mm, line width=.8pt, align=center, inner sep=1.3mm},
  boxgreen/.style={draw=teal, fill=teal!12, rounded corners=1.2mm, line width=.8pt, align=center, inner sep=1.3mm},
  boxorange/.style={draw=orangeink, fill=orangeink!12, rounded corners=1.2mm, line width=.8pt, align=center, inner sep=1.3mm},
  boxgrey/.style={draw=greyink, fill=greyink!10, rounded corners=1.2mm, line width=.8pt, align=center, inner sep=1.3mm},
  tinyarrow/.style={-{Stealth[length=1.8mm]}, line width=.7pt},
}

%% ---------------------------------------------------------------- per-spread state
\newcounter{ss@nb}
\newif\ifss@side
\def\ss@lasty{0}\def\ss@lasttop{0}
\newcommand\ss@reset{\setcounter{ss@nb}{0}\gdef\ss@lasty{0}\gdef\ss@lasttop{0}%
  \gdef\ss@marks{}\gdef\ss@draw{}\gdef\ss@arrows{}\gdef\ss@crumbs{}\gdef\ss@here{}}
\ss@reset

%% \crumbs{§2 Method › Figure 3}: breadcrumb under the header       \insection{intro,method}: pills to light up
\newcommand\crumbs[1]{\gdef\ss@crumbs{#1}}
\newcommand\insection[1]{\gdef\ss@here{#1}}

%% \block[y=<top mm>, x=<offset mm>, w=<width mm>, name=<node>, side, gap=<mm>]{...}
%%   y    : desired top (the y of what it explains); if the previous block ends lower it goes just below it
%%   side : same top as the previous block (side by side): give both blocks x and w
%%   name : TikZ node name for \arrowto (default b1, b2, ...)
\pgfkeys{/ssblock/.is family, /ssblock,
  y/.store in=\ss@y, x/.store in=\ss@x, w/.store in=\ss@w,
  name/.store in=\ss@name, gap/.store in=\ss@gap, side/.code={\ss@sidetrue}}
\NewDocumentCommand\block{O{}+m}{%
  \ss@sidefalse
  \pgfkeys{/ssblock, y=-1, x=0, w=\ss@wn, name=, gap=3.2, #1}%
  \stepcounter{ss@nb}%
  \edef\ss@bx{ss@box\the\value{ss@nb}}%
  \ifcsname\ss@bx\endcsname\else\expandafter\newbox\csname\ss@bx\endcsname\fi
  \global\setbox\csname\ss@bx\endcsname=\vbox{\begin{minipage}[t]{\ss@w mm}\ss@body #2\par\end{minipage}}%
  \pgfmathsetmacro\ss@h{(\ht\csname\ss@bx\endcsname+\dp\csname\ss@bx\endcsname)/2.845274}%
  \ifss@side
    \let\ss@top\ss@lasttop
  \else
    \pgfmathsetmacro\ss@min{max(\ss@lasty+\ss@gap, \ss@ytop)}%
    \pgfmathsetmacro\ss@top{max(\ss@y, \ss@min)}%
  \fi
  \pgfmathsetmacro\ss@bot{\ss@top+\ss@h}%
  \xdef\ss@lasttop{\ss@top}%
  \pgfmathsetmacro\ss@new{max(\ss@lasty, \ss@bot)}\xdef\ss@lasty{\ss@new}%
  \ifdim\ss@bot pt>\ss@ybot pt
    \PackageWarning{studysheet}{OVERFLOW page \ss@page: block \the\value{ss@nb} ends at \ss@bot\space mm
      (limit \ss@ybot)}%
  \fi
  \pgfmathsetmacro\ss@yy{\ss@H-\ss@top}%
  \pgfmathsetmacro\ss@xx{\ss@xn+\ss@x}%
  \ifx\ss@name\@empty\edef\ss@nm{b\the\value{ss@nb}}\else\let\ss@nm\ss@name\fi
  \xappto\ss@draw{\noexpand\node[anchor=north west, inner sep=0pt, outer sep=0pt] (\ss@nm)
    at (\ss@xx,\ss@yy) {\noexpand\usebox{\expandafter\noexpand\csname\ss@bx\endcsname}};}%
  \typeout{SS-BLOCK page \ss@page\space block \the\value{ss@nb}: top \ss@top\space bot \ss@bot\space limit \ss@ybot}%
}
%% \room{mm}: keep extra white space below the last block
\newcommand\room[1]{\pgfmathsetmacro\ss@new{\ss@lasty+#1}\xdef\ss@lasty{\ss@new}}

%% ---------------------------------------------------------------- marks on the ORIGINAL page (mm from top-left)
%% \highlight[colour]{x0}{y0}{x1}{y1}: highlighter over a phrase (hlyellow, hlgreen, hlblue, hlpink)
\newcommand\highlight[5][hlyellow]{\gappto\ss@marks{%
  \fill[#1, opacity=.55, blend mode=multiply, rounded corners=.5mm] (#2-.4,\ss@H-#3+.3) rectangle (#4+.4,\ss@H-#5-.3);}}
%% \pencilbox[colour]{x0}{y0}{x1}{y1}: hand-drawn box (an equation, a key number, a figure panel)
%% (pencil strokes are drawn relative to their own corner: the random-steps decoration overflows on large coordinates)
\newcommand\pencilbox[5][pen]{\gappto\ss@marks{%
  \begin{scope}[shift={(#2-1.2,\ss@H-#5-1.0)}]\draw[pencil, #1] (0,0) rectangle (#4-#2+2.4,#5-#3+2.0);\end{scope}}}
%% \ring[colour]{x0}{y0}{x1}{y1}: hand-drawn ellipse around a small item
\newcommand\ring[5][pen]{\gappto\ss@marks{%
  \begin{scope}[shift={({(#2+#4)/2},{\ss@H-(#3+#5)/2})}, rotate=-4]\draw[#1, line width=.85pt] (0,0)
    ellipse [x radius={(#4-#2)/2+2.0}, y radius={(#5-#3)/2+1.5}];\end{scope}}}
%% \penunderline[colour]{x0}{x1}{y}: hand underline (y = bottom of the text line)
\newcommand\penunderline[4][pen]{\gappto\ss@marks{%
  \begin{scope}[shift={(#2,\ss@H-#4-.4)}]\draw[pencil, #1, line width=.8pt, rounded corners=0pt] (0,0) -- (#3-#2,0);\end{scope}}}
%% \bracket[colour]{n}{y0}{y1}: bracket with badge n in the right margin of the original (paragraph groups)
\newcommand\bracket[4][pen]{\gappto\ss@marks{%
  \draw[#1, line width=.9pt, line cap=round] (\ss@xmark-1.2,\ss@H-#3) -- (\ss@xmark,\ss@H-#3) -- (\ss@xmark,\ss@H-#4) -- (\ss@xmark-1.2,\ss@H-#4);
  \node[circle, fill=#1, text=white, inner sep=0pt, minimum size=4.3mm, font=\printed\bfseries\fontsize{7.5}{8}\selectfont]
    at (\ss@xmark+4.6,{\ss@H-(#3+#4)/2}) {#2};}}
%% \badge[colour]{n}{x}{y}: badge n anywhere on the original (beside a figure panel, in the left margin)
\newcommand\badge[4][pen]{\gappto\ss@marks{%
  \node[circle, fill=#1, text=white, inner sep=0pt, minimum size=4.3mm, font=\printed\bfseries\fontsize{7.5}{8}\selectfont]
    at (#3,\ss@H-#4) {#2};}}
%% \arrowto[colour]{node}{x}{y}: curved pen arrow from a notes block (b3, or name=) to a point of the original
\newcommand\arrowto[4][pen]{\gappto\ss@arrows{%
  \draw[penarrow, #1] (#2.west) .. controls +(-14,0) and +(12,4) .. (#3,\ss@H-#4);}}
%% \margintext[colour]{x}{y}{text}: a short handwritten word on the original (margins only)
\newcommand\margintext[4][pen]{\gappto\ss@marks{%
  \node[anchor=west, text=#1, font=\fontsize{8}{9}\selectfont, inner sep=0pt] at (#2,\ss@H-#3) {#4};}}

%% ---------------------------------------------------------------- page furniture
\newcommand\ss@paper{%
  \fill[paper] (\ss@W,0) rectangle (2*\ss@W,\ss@H);
  \fill[pattern={Dots[radius=.22mm, distance=5mm]}, pattern color=dots] (\ss@W+5,6) rectangle (2*\ss@W-4,\ss@H-27.5);
  \shade[left color=black!16, right color=paper] (\ss@W,0) rectangle (\ss@W+4.5,\ss@H);
  \draw[black!22, line width=.3pt] (\ss@W,0) -- (\ss@W,\ss@H);}
\newcommand\ss@header{%
  \node[anchor=base west, inner sep=0pt, text=ink, font=\fontsize{14.5}{16}\selectfont\bfseries]
    at (\ss@xn,\ss@H-11) {\textcolor{pen}{\faPen}\ \ss@tNotes};
  \node[anchor=base east, inner sep=0pt, text=greyink, font=\printed\fontsize{8}{9}\selectfont]
    at (\ss@xn+\ss@wn,\ss@H-11) {\ss@tPage\ \ss@page\,/\,\ss@total};
  \node[anchor=base west, inner sep=0pt, text=accent, font=\fontsize{9.2}{11}\selectfont, text width=\ss@wn mm]
    at (\ss@xn,\ss@H-17.2) {\ss@crumbs};
  \ifx\ss@sections\@empty\else
  \pgfmathsetmacro\ss@pw{\ss@wn/\ss@nsections}%
  \foreach \k/\t [count=\i from 0] in \ss@sections {
    \pgfmathsetmacro\xa{\ss@xn+\i*\ss@pw}
    \edef\ss@k{,\k,}\edef\ss@list{,\ss@here,}%
    \expandafter\expandafter\expandafter\in@\expandafter\expandafter\expandafter{\expandafter\ss@k\expandafter}\expandafter{\ss@list}%
    \ifin@
      \fill[accent, rounded corners=.8mm] (\xa+.3,\ss@H-24.4) rectangle (\xa+\ss@pw-.3,\ss@H-20.6);
      \node[text=white, font=\printed\bfseries\fontsize{5.8}{6}\selectfont, inner sep=0pt] at (\xa+\ss@pw/2,\ss@H-22.5) {\t};
    \else
      \fill[accent!9, rounded corners=.8mm] (\xa+.3,\ss@H-24.4) rectangle (\xa+\ss@pw-.3,\ss@H-20.6);
      \node[text=accent!55, font=\printed\fontsize{5.8}{6}\selectfont, inner sep=0pt] at (\xa+\ss@pw/2,\ss@H-22.5) {\t};
    \fi
  }\fi
  \draw[ink!35, line width=.5pt, decorate, decoration={random steps, segment length=4mm, amplitude=.2mm}]
    (\ss@xn,\ss@H-27.3) -- (\ss@xn+\ss@wn,\ss@H-27.3);}
\newcommand\ss@footer{%
  \node[anchor=base west, inner sep=0pt, text=greyink!80, font=\printed\fontsize{6.5}{7}\selectfont]
    at (\ss@xn,3.2) {\ss@foot};
  \node[anchor=base east, inner sep=0pt, text=greyink!80, font=\fontsize{7.5}{8}\selectfont]
    at (\ss@xn+\ss@wn,3.2) {\faPencil*\ \ss@tRoom};}

%% \studypage{n}: one spread (original page n | notes/pNN.tex)
\newcommand\studypage[1]{%
  \edef\ss@page{\number#1}%
  \ss@reset\ss@derive
  \pgfmathsetseed{\numexpr 1000+#1\relax}%
  \edef\ss@file{notes/p\ifnum#1<10 0\fi\number#1}%
  \IfFileExists{\ss@file.tex}{\input{\ss@file}}{%
    \crumbs{\ldots}\block{\grey{\ss@tPending}}}%
  \noindent\begin{tikzpicture}[x=1mm, y=1mm]
    \useasboundingbox (0,0) rectangle (2*\ss@W,\ss@H);
    \node[anchor=south west, inner sep=0pt] at (0,0)
      {\includegraphics[page=\ss@page, width=\ss@W mm, height=\ss@H mm]{\ss@pdf}};
    \ss@paper
    \ss@header
    \ss@marks
    \ss@draw
    \ss@arrows
    \ss@footer
  \end{tikzpicture}\par\newpage}
%% \StudyPages{1,2,3}: the spreads to build (annotate_pdf.py writes the selection)
\newcommand\StudyPages[1]{\forcsvlist\studypage{#1}}
\endinput
