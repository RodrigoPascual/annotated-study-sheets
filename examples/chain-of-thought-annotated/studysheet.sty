%% studysheet.sty — annotated study copy of a PDF (part of the annotated-study-sheets skill, MIT licence).
%% Every output page is a spread: the ORIGINAL page on the left, untouched (pencil marks drawn on top of it),
%% and a dotted-paper notes page on the right whose blocks sit beside what they explain.
%% Compile with LuaLaTeX (scripts/annotate_pdf.py build). Do not edit this file per document: configure it in main.tex.
%% Coordinates on the original page are in mm from its TOP-LEFT corner (scripts/annotate_pdf.py anchors N prints them).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{studysheet}[2026/11/18 v1.1 annotated study copy of a PDF]

\RequirePackage{fontspec}
\RequirePackage{unicode-math}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\RequirePackage{xparse}
\RequirePackage{enumitem}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{tabularx}
\RequirePackage{fontawesome5}
\RequirePackage{luacolor}
\RequirePackage{lua-ul}
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\usetikzlibrary{calc, arrows.meta, decorations.pathmorphing, patterns.meta, positioning, shapes.geometric}

